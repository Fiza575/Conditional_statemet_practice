# for loop
for a in range (5):
  print("I will study everyday")

# While loop
a = 2
while a <=10:
  print(a)
  a = a +1

# Nested loop
for lunchbox in range (2):
  print("Lunchbox",lunchbox+1)
  for snacks in range (3):
    print("Snacks",snacks+1)

# Break the loop
for a in range (5):
  if a ==3:
    break
  print(a)

  # Continue
  for a in range (5):
    if a ==3:
      continue
    print(a)
  